<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- FsLexYacc runtime via NuGet -->    
    <PackageReference Include="FsLexYacc" Version="11.3.0" />
    <PackageReference Include="FsLexYacc.Runtime" Version="11.3.0" />
  </ItemGroup>
  
  <ItemGroup>
    <Compile Include="Absyn.fs" />
    <Compile Include="ExprPar.fs" />
    <Compile Include="ExprLex.fs" />
    <Compile Include="Parse.fs" />
  </ItemGroup>

    <ItemGroup>
    <!-- Source generators -->
    <FsYacc Include="ExprPar.fsy">
      <OtherFlags>--module ExprPar</OtherFlags>
    </FsYacc>

    <FsLex Include="ExprLex.fsl">
      <OtherFlags>--unicode</OtherFlags>
    </FsLex>
  </ItemGroup>
</Project>
